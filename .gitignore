# Python
__pycache__/
*.py[cod]
*.pyo
venv/
.venv/
*.egg-info/

# Node / フロントエンド
node_modules/
dist/
web/dist/
.env.local

# 実行時生成物
# 自動運転のモードとパラメータ（telemetry_node が GUI の操作を保存する）。
# **機体ごとに詰めた値なのでコミットしない**（別の機体に持っていくと危ない）
surge_mk2/config/auto.json
# カメラ capture 設定（後方ON/OFF・前後FPS上限・GUI配信fps）。auto.json と同じ理由
surge_mk2/config/camera.json
# 総走行距離（io_node が odom_center の起点として読む）。auto.json と同じ理由
surge_mk2/config/odometer.json
# 選ばれているセグメンテーションモデル名。auto.json と同じ理由
surge_mk2/config/cam_model.json
# 選ばれているE2E LiDARモデル名。auto.json と同じ理由
surge_mk2/config/e2e_lidar_model.json
logs/*.jsonl
*.sfl          # 生フレームログ（大きい・実行ごとに増える）
*.mcap
saved_maps/*.npz
saved_maps/*.json

# ml/（カメラセグメンテーションのオフライン学習パイプライン）の生成物・大容量ファイル
# 走行データ・アノテーション・学習済み重みは機体/走行ごとに違い、しかも大きい
#
# ★ .gitignore の `#` は行頭でしか comment 扱いにならない。パターン末尾に
#   付けると `#` ごとリテラルなパターンとして解釈され、何もマッチしなくなる
#   （実際に一度これで surge_mk2/ml/data/・surge_mk2/ml/runs/ が無視されない
#   事故を起こした。理由を書いた行を分けておく）
# surge_mk2/ml/data/  … 抽出フレーム・マスク・manifest.csv
# surge_mk2/ml/runs/  … チェックポイント(.pt)・ONNX書き出し・学習ログ
surge_mk2/ml/data/
surge_mk2/ml/runs/
# SAM のチェックポイント（`ml/annotate.py` が使う、数百MB〜数GB）。
# ダウンロード先はどこでも良いのでリポジトリ全体で除外する
sam_*.pth
*.pth

# cam_perception_node に配置する ONNX モデル（`ml/export_onnx.py` の出力を
# Pi の models/ に手動で配置する運用）。機体・学習ごとに違う大容量ファイル
surge_mk2/models/

# ml_lidar/（LiDAR E2E強化学習パイプライン）の生成物・大容量ファイル
# PPOのcheckpoint・TensorBoardログ。学習ごとに違い、しかも大きい
surge_mk2/ml_lidar/runs/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# 機密情報
surge_mk2/docs/setup_credentials.md
# telemetry_node の操縦権トークン（`--token` 省略時の読み先）
surge_mk2/config/secret.txt

# Python
__pycache__/
*.py[cod]
*.pyo
venv/
.venv/
*.egg-info/

# Node / フロントエンド
node_modules/
dist/
web/dist/
.env.local

# 実行時生成物
# ステレオの後処理の C 版を、その機械で初回にビルドしたもの（raspi/core/stereo_native.py）
surge_mk2/raspi/core/_native_build/
# 自動運転のモードとパラメータ（telemetry_node が GUI の操作を保存する）。
# **機体ごとに詰めた値なのでコミットしない**（別の機体に持っていくと危ない）
surge_mk2/config/auto.json
surge_mk2/config/auto_presets.json
# カメラ capture 設定（後方ON/OFF・前後FPS上限・GUI配信fps）。auto.json と同じ理由
surge_mk2/config/camera.json
# 総走行距離（io_node が odom_center の起点として読む）。auto.json と同じ理由
surge_mk2/config/odometer.json
# 選ばれているセグメンテーションモデル名。auto.json と同じ理由
surge_mk2/config/cam_model.json
# 選ばれているE2E LiDARモデル名。auto.json と同じ理由
surge_mk2/config/e2e_lidar_model.json
# 選ばれているカメラE2Eモデル名。auto.json と同じ理由
surge_mk2/config/cam_e2e_model.json
# 選ばれているE2E融合・ステレオE2Eのモデル名。auto.json と同じ理由
surge_mk2/config/e2e_fusion_model.json
surge_mk2/config/stereo_e2e_model.json
# GUIの運転設定（速度・制御モード等）。auto.json と同じ理由
surge_mk2/config/drive_settings.json
# シミュレータのチューニング値（TUNABLESパネル）。auto.json と同じ理由
surge_mk2/config/sim_params.json
logs/*.jsonl
# 生フレームログ（大きい・実行ごとに増える）
*.sfl
*.mcap
surge_mk2/saved_maps/*.npz
surge_mk2/saved_maps/*.json
# 地図ごとの仕上げた経路の写し（planner が書く。大きい・機体ごと）
surge_mk2/saved_maps/*.pkl

# 学習済みの重み（`*.pth`）。大容量で機体・学習ごとに違うのでリポジトリ全体で除外する
*.pth

# 推論ノードに配置する ONNX モデル（各 `ml_*/export_onnx.py` の出力を
# Pi の models/ に配置する運用）。機体・学習ごとに違う大容量ファイル
surge_mk2/models/

# ml_lidar/（LiDAR E2E強化学習パイプライン）の生成物・大容量ファイル
# PPOのcheckpoint・TensorBoardログ。学習ごとに違い、しかも大きい
surge_mk2/ml_lidar/runs/

# ml_cam_e2e/（カメラE2E模倣学習パイプライン）の生成物。抽出フレーム（JPEG数千枚）・
# チェックポイント・評価結果。学習ごとに違い、しかも大きい
surge_mk2/ml_cam_e2e/runs/

# ml_e2e/（LiDAR＋カメラ＋車両状態の融合E2E）の生成物。抽出した標本（JPEG・npz）・
# チェックポイント・評価結果
surge_mk2/ml_e2e/runs/
# ml_stereo_e2e/（ステレオの画像＋視差の E2E）の生成物。ml_e2e/runs/ と同じ
surge_mk2/ml_stereo_e2e/runs/

# slam2d/（汎用2D LiDAR SLAM）の検証用生ログ。公開データセットは各自ダウンロードする
# 前提で、slam2d/datasets/README.md に入手手順だけ書く
surge_mk2/slam2d/datasets/raw/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# 機密情報
surge_mk2/docs/setup_credentials.md
# telemetry_node の操縦権トークン（`--token` 省略時の読み先）
surge_mk2/config/secret.txt

# sim.park_bench --plot の出力（デバッグ用の生成物）
surge_mk2/park_bench_result.png


# Python
__pycache__/
*.py[cod]
*.pyo
venv/
.venv/
*.egg-info/

# Node / フロントエンド
node_modules/
dist/
web/dist/
.env.local

# 実行時生成物
# 自動運転のモードとパラメータ（telemetry_node が GUI の操作を保存する）。
# **機体ごとに詰めた値なのでコミットしない**（別の機体に持っていくと危ない）
surge_mk2/config/auto.json
logs/*.jsonl
*.sfl          # 生フレームログ（大きい・実行ごとに増える）
*.mcap
saved_maps/*.npz
saved_maps/*.json

# ml/（カメラセグメンテーションのオフライン学習パイプライン）の生成物・大容量ファイル
# 走行データ・アノテーション・学習済み重みは機体/走行ごとに違い、しかも大きい
surge_mk2/ml/data/        # 抽出フレーム・マスク・manifest.csv
surge_mk2/ml/runs/        # チェックポイント(.pt)・ONNX書き出し・学習ログ
# SAM のチェックポイント（`ml/annotate.py` が使う、数百MB〜数GB）。
# ダウンロード先はどこでも良いのでリポジトリ全体で除外する
sam_*.pth
*.pth

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# 機密情報
surge_mk2/docs/setup_credentials.md
# telemetry_node の操縦権トークン（`--token` 省略時の読み先）
surge_mk2/config/secret.txt
